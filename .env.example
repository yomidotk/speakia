# Copy to .env and fill in after deploying the server (see README).
# Leave empty to run in demo mode.
EXPO_PUBLIC_API_URL=

# Firebase web config (Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: Firebase > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
